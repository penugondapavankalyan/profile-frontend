# VITE_ENABLE_CHAT=true  -> always call the backend; failures show an error with Retry.
# VITE_ENABLE_CHAT=false -> no request is made; a "backend not connected" notice is shown.
VITE_ENABLE_CHAT=true
VITE_CHAT_API_BASE_URL=https://api.example.invalid
# Local runner: /chat
# Local Lambda container (RIE): /2015-03-31/functions/function/invocations
VITE_CHAT_API_PATH=/chat
# Optional — set to true only when testing against a local Lambda container (RIE).
# Leave unset (or false) for the local runner and production.
# VITE_LAMBDA_INVOKE=true
# Dev only (not bundled): backend URL the Vite dev server proxies "/lambda" to.
# Use with VITE_CHAT_API_BASE_URL=/lambda to avoid CORS locally.
# CHAT_PROXY_TARGET=http://localhost:9002
VITE_PROFILE_NAME=Your Name
VITE_PROFILE_EMAIL=you@example.com
VITE_CONTACT_LINK=
VITE_LINKEDIN_URL=
VITE_GITHUB_URL=
